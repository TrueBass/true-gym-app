# Where the app finds the API.
#
# EXPO_PUBLIC_ is correct here and only here: Expo inlines these into the JS
# bundle, which is fine for a base URL and never acceptable for a secret.
#
# A phone can't reach "localhost" — that's the phone itself. Use this machine's
# address on your network, the same one Expo prints when the dev server starts.
EXPO_PUBLIC_API_URL=http://192.168.1.72:8000
