# Copy to `.env` and fill in real values. `.env` is gitignored; this file is committed.
#
# Avoid `$` inside any value. Docker Compose reads this file for interpolation,
# so `$U` in a password or a signing key is substituted with an empty string —
# the container then gets a different value than a venv run does, silently.
# Generate keys with `openssl rand -base64 32`, whose alphabet has no `$`.
#
# WARNING: nothing here may ever be prefixed with EXPO_PUBLIC_.
# Expo inlines every EXPO_PUBLIC_* variable into the JS bundle as plain text, so
# anything carrying that prefix ships to the device and is readable by anyone who
# unpacks the app. These values are for a server/backend only.

# ---------------------------------- Postgres ---------------------------------
# The API reads this one and nothing else. A plain postgresql:// URL is fine —
# the async driver is appended in code, so a URL copied from a managed host
# works unedited.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# docker-compose.yml reads these to initialise the Postgres container: they are
# what the role and database inside it are created as, so they must match the
# user, password and database in DATABASE_URL above or the API cannot log in.
# They apply only when the volume is first created — changing them afterwards
# does nothing to an existing cluster.
PGUSER=USER
PGPASSWORD=PASSWORD
PGHOST=localhost
PGPORT=5432
PGDATABASE=true_gym
PGSSLMODE=require

# --------------------------- App admin / test account -------------------------
# A seeded superuser inside the app itself, for local testing.
#
# To have the app read these, they must be renamed with an EXPO_PUBLIC_ prefix
# (EXPO_PUBLIC_ADMIN_EMAIL, ...) — that is the only way Expo exposes a variable
# to the bundle, and it means the value ships inside the app. So: throwaway
# credentials only, and gate the seeding behind `if (__DEV__)` so it can never
# run in a release build.
APP_ADMIN_NAME=Admin
APP_ADMIN_EMAIL=admin@truegym.local
APP_ADMIN_PASSWORD=replace-with-a-dev-only-password

# Seeded non-admin account, useful for testing the normal-user path.
APP_TEST_USER_EMAIL=user@truegym.local
APP_TEST_USER_PASSWORD=replace-with-a-dev-only-password

# ----------------------------------- Auth ------------------------------------
# Signing key for the API's access tokens.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-generated-secret

# Optional — the values below are the defaults, listed so they're discoverable.
#
# The app has no "remember me" checkbox: every login is remembered. The access
# token therefore stays short-lived and the refresh token carries the session,
# renewed silently by the client. Changing JWT_SECRET invalidates every access
# token in the wild; refresh tokens live in the database and survive it.
# ACCESS_TOKEN_TTL_MINUTES=30
# REFRESH_TOKEN_TTL_DAYS=90

# Comma-separated browser origins allowed to call the API. The native app sends
# no Origin and is unaffected; this exists for `expo start --web`. Narrow it
# from the default "*" before anything ships.
# CORS_ORIGINS=["http://localhost:8081"]
